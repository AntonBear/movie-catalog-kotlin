<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Button" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@drawable/button_enabled_selector</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">?attr/colorPrimary</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxStrokeColor">@android:color/transparent</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>





    <style name="MyButtonTextStyle">
        <item name="android:fontFamily">@font/manrope_bold</item>
    </style>

    <style name="ButtonWithSvgMaterial" parent="Widget.MaterialComponents.Button">
        <!-- Сохраняем твой кастомный фон, если есть drawable -->
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/button_layer_list</item>

        <!-- Сохраняем шрифты и текст -->
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>

        <!-- Скругление и размеры -->
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="ButtonWithSvgStyle" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/button_layer_list</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="BottomNavigationView.NoShiftMode" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemTextColor">@color/bottom_nav_text_colors</item>
        <item name="itemIconTint">@color/bottom_nav_icon_colors</item>
    </style>

    <style name="BottomNavigationTextStyle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="BottomNavigationTextStyleActive" parent="BottomNavigationTextStyle">
        <item name="android:textColor">@color/selected_color</item>
    </style>

    <style name="BottomNavigationTextStyleInactive" parent="BottomNavigationTextStyle">
        <item name="android:textColor">@color/gray_faded</item>
    </style>




    <style name="ChipTextAppearance" parent="TextAppearance.MaterialComponents.Chip">
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="CustomChipStyle" parent="Widget.MaterialComponents.Chip.Action">
        <item name="android:textColor">@color/white</item>
        <item name="chipBackgroundColor">@color/dark_faded</item>

    </style>
    <style name="RoundedChip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipCornerRadius">1dp</item>
    </style>

</resources>